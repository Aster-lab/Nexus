DATABASE_ENV=demo
DATABASE_URL=postgresql://nexus_app:replace_me@127.0.0.1:5432/nexus_demo?schema=public
NEXUS_DEMO_MODE=true
NEXTAUTH_SECRET=replace_with_a_random_secret_of_at_least_32_characters
AUTH_RATE_LIMIT_SECRET=replace_with_a_different_random_secret_of_at_least_32_characters

# Add dedicated app secrets and OAuth settings as needed; never copy production
# credentials into this file. Copy this template to .env.demo and keep it local.
