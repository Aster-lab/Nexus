{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:staging": "dotenv run -f .env.staging -- playwright test",
    "pretest": "dotenv run -f .env.test -- tsx scripts/assert-db-environment.ts test",
    "test": "dotenv run -f .env.test -- vitest run",
    "pretest:watch": "dotenv run -f .env.test -- tsx scripts/assert-db-environment.ts test",
    "test:watch": "dotenv run -f .env.test -- vitest",
    "db:status:dev": "prisma migrate status",
    "db:status:test": "dotenv run -f .env.test -- prisma migrate status",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:test": "dotenv run -f .env.test -- prisma migrate deploy",
    "db:studio:dev": "prisma studio",
    "db:studio:test": "dotenv run -f .env.test -- prisma studio",
    "db:seed:dev": "dotenv run -f .env -- tsx prisma/seed/index.ts",
    "db:seed:test": "dotenv run -f .env.test -- tsx prisma/seed/index.ts",
    "admin:bootstrap": "dotenv run -f .env -- tsx scripts/bootstrap-admin.ts",
    "demo:setup": "dotenv run -f .env.demo -- tsx scripts/setup-demo.ts",
    "demo:activate-policies": "dotenv run -f .env.demo -- tsx scripts/activate-demo-policies.ts",
    "predemo:migrate": "dotenv run -f .env.demo -- tsx scripts/assert-demo-environment.ts",
    "demo:migrate": "dotenv run -f .env.demo -- prisma migrate deploy",
    "demo:reset": "dotenv run -f .env.demo -- tsx scripts/reset-demo.ts",
    "demo:build": "dotenv run -f .env.demo -- next build --webpack",
    "demo:start": "dotenv run -f .env.demo -- next dev",
    "db:reset:dev": "dotenv run -f .env -- tsx scripts/reset-database.ts development",
    "db:reset:test": "dotenv run -f .env.test -- tsx scripts/reset-database.ts test",
    "db:deploy:dev": "prisma migrate deploy",
    "predb:deploy:dev": "dotenv run -f .env -- tsx scripts/assert-db-environment.ts development",
    "predb:status:dev": "dotenv run -f .env -- tsx scripts/assert-db-environment.ts development",
    "predb:status:test": "dotenv run -f .env.test -- tsx scripts/assert-db-environment.ts test",
    "predb:migrate:dev": "dotenv run -f .env -- tsx scripts/assert-db-environment.ts development",
    "predb:migrate:test": "dotenv run -f .env.test -- tsx scripts/assert-db-environment.ts test",
    "predb:studio:dev": "dotenv run -f .env -- tsx scripts/assert-db-environment.ts development",
    "predb:studio:test": "dotenv run -f .env.test -- tsx scripts/assert-db-environment.ts test",
    "predb:seed:dev": "dotenv run -f .env -- tsx scripts/assert-db-environment.ts development",
    "predb:seed:test": "dotenv run -f .env.test -- tsx scripts/assert-db-environment.ts test",
    "predb:reset:dev": "dotenv run -f .env -- tsx scripts/assert-db-environment.ts development",
    "predb:reset:test": "dotenv run -f .env.test -- tsx scripts/assert-db-environment.ts test"
  },
  "dependencies": {
    "@geothai/core": "^5.0.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.41.0",
    "next": "^16.4.4",
    "next-auth": "^4.24.15",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "^16.4.4",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "effect": "3.22.1"
  }
}
