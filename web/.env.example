DATABASE_URL=
DIRECT_URL=
# Local PostgreSQL development/test setup: see docs/LOCAL_POSTGRES_SETUP.md.
# Use separate databases (nexus_dev and nexus_test), not the same database for both.
ML_SERVICE_URL=http://127.0.0.1:8000
# Set both tokens to independent random secrets of at least 32 characters.
# The ML_SERVICE_TOKEN must match the one in ML/.env. Keep both server-side only.
ML_SERVICE_TOKEN=
PREDICTION_PERSIST_TOKEN=
# Generate a unique random value of at least 32 characters for local and deployed environments.
AUTH_RATE_LIMIT_SECRET=

DATABASE_ENV = 
DATABASE_URL_SHA256=
