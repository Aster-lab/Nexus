  scannedAt      DateTime           @default(now()) @map("scanned_at") @db.Timestamptz(6)

  document ApplicationDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([documentId, scannedAt])
  @@index([result, scannedAt])
  @@map("document_security_scans")
}

model DocumentAccessLog {
