//retention and backup
model RetentionPolicy {
  id                String                  @id @default(uuid()) @db.Uuid
  policyCode        String                  @map("policy_code") @db.VarChar(80)
  dataCategory      String                  @map("data_category") @db.VarChar(80)
  retentionDuration Unsupported("interval") @map("retention_duration")
  retentionTrigger  String                  @map("retention_trigger") @db.VarChar(80)
  action            RetentionPolicyAction
  versionNumber     Int                     @map("version_number")
  status            RetentionPolicyStatus   @default(PROPOSED)
  approvedByUserId  String?                 @map("approved_by_user_id") @db.Uuid
  effectiveAt       DateTime?               @map("effective_at") @db.Timestamptz(6)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  approvedBy User?                @relation(fields: [approvedByUserId], references: [id], onDelete: Restrict)
  executions RetentionExecution[]

  @@unique([policyCode, versionNumber])
  @@index([status, effectiveAt])
  // Positive version numbers and approval prerequisites are enforced in SQL.
  @@map("retention_policies")
}

model RetentionExecution {
  id                String                   @id @default(uuid()) @db.Uuid
  retentionPolicyId String                   @map("retention_policy_id") @db.Uuid
  targetType        String                   @map("target_type") @db.VarChar(80)
  targetId          String                   @map("target_id") @db.Uuid
  action            String                   @db.VarChar(30)
  status            RetentionExecutionStatus @default(PENDING)
  reason            String?
  executedAt        DateTime?                @map("executed_at") @db.Timestamptz(6)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  retentionPolicy RetentionPolicy @relation(fields: [retentionPolicyId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  // A completed execution must carry its execution timestamp; enforced in SQL.
  @@map("retention_executions")
}

model BackupRecord {
  id                     String       @id @default(uuid()) @db.Uuid
  backupType             String       @map("backup_type") @db.VarChar(50)
  storageReference       String       @map("storage_reference") @db.VarChar(500)
  checksum               String       @db.VarChar(128)
  encryptionKeyReference String       @map("encryption_key_reference") @db.VarChar(255)
  status                 BackupStatus @default(CREATED)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  verifiedAt             DateTime?    @map("verified_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  // Verified backups require verifiedAt; enforced in SQL. Store only a key reference, never key material.
  @@map("backup_records")
}
