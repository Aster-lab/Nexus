//finanical operations
model WithdrawalRequest {
  id                            String                  @id @default(uuid()) @db.Uuid
  userId                        String                  @map("user_id") @db.Uuid
  walletId                      String                  @map("wallet_id") @db.Uuid
  amountSatang                  BigInt                  @map("amount_satang")
  simulatedDestinationReference String?                 @map("simulated_destination_reference") @db.VarChar(255)
  status                        WithdrawalRequestStatus @default(REQUESTED)
  idempotencyKey                String                  @unique @map("idempotency_key") @db.VarChar(255)
  ledgerTransactionId           String?                 @map("ledger_transaction_id") @db.Uuid
  createdAt                     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt                   DateTime?               @map("completed_at") @db.Timestamptz(6)

  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet            Wallet             @relation(fields: [walletId], references: [id], onDelete: Restrict)
  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([walletId, status])
  @@index([status, createdAt])
  // Positive amount, owner consistency, and completed-ledger requirements are enforced in SQL.
  @@map("withdrawal_requests")
}

model IdempotencyRecord {
  id               String            @id @default(uuid()) @db.Uuid
  idempotencyKey   String            @unique @map("idempotency_key") @db.VarChar(255)
  userId           String?           @map("user_id") @db.Uuid
  operationType    String            @map("operation_type") @db.VarChar(80)
  requestHash      String            @map("request_hash") @db.VarChar(128)
  status           IdempotencyStatus @default(PROCESSING)
  responseSnapshot Json?             @map("response_snapshot")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt      DateTime?         @map("completed_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  // Completion timestamp consistency is enforced in SQL; request-hash semantics belong to the command handler.
  @@map("idempotency_records")
}

model OutboxEvent {
  id            String            @id @default(uuid()) @db.Uuid
  eventType     String            @map("event_type") @db.VarChar(100)
  aggregateType String            @map("aggregate_type") @db.VarChar(80)
  aggregateId   String            @map("aggregate_id") @db.Uuid
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attemptCount  Int               @default(0) @map("attempt_count")
  nextAttemptAt DateTime?         @map("next_attempt_at") @db.Timestamptz(6)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt   DateTime?         @map("completed_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
  @@index([createdAt])
  // Nonnegative attempts and completion timestamp consistency are enforced in SQL.
  @@map("outbox_events")
}

model SystemEvent {
  id        String   @id @default(uuid()) @db.Uuid
  eventType String   @map("event_type") @db.VarChar(100)
  source    String   @db.VarChar(100)
  status    String   @db.VarChar(30)
  metadata  Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([eventType, createdAt])
  @@index([source, createdAt])
  @@index([status, createdAt])
  @@map("system_events")
}

//Document
model ApplicationDocument {
  id                   String                  @id @default(uuid()) @db.Uuid
  applicationId        String                  @map("application_id") @db.Uuid
  applicationVersionId String                  @map("application_version_id") @db.Uuid
  uploadedByUserId     String                  @map("uploaded_by_user_id") @db.Uuid
  documentType         ApplicationDocumentType @map("document_type")
  objectKey            String                  @map("object_key") @db.VarChar(500)
  originalFilename     String                  @map("original_filename") @db.VarChar(255)
  detectedMimeType     String                  @map("detected_mime_type") @db.VarChar(150)
  fileSizeBytes        BigInt                  @map("file_size_bytes")
  checksum             String                  @db.VarChar(128)
  versionNumber        Int                     @map("version_number")
  scanStatus           DocumentScanStatus      @default(QUARANTINED) @map("scan_status")
  documentStatus       DocumentStatus          @default(ACTIVE) @map("document_status")
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt            DateTime?               @map("deleted_at") @db.Timestamptz(6)

  application        LoanApplication        @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  applicationVersion ApplicationVersion     @relation(fields: [applicationId, applicationVersionId], references: [applicationId, id], onDelete: Restrict)
  uploadedBy         User                   @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  securityScans      DocumentSecurityScan[]
  accessLogs         DocumentAccessLog[]

  @@unique([applicationVersionId, documentType, versionNumber])
  @@index([applicationId])
  @@index([applicationVersionId, scanStatus])
  @@index([uploadedByUserId])
  @@map("application_documents")
}

model DocumentSecurityScan {
  id             String             @id @default(uuid()) @db.Uuid
  documentId     String             @map("document_id") @db.Uuid
  scannerVersion String             @map("scanner_version") @db.VarChar(100)
  result         DocumentScanResult
