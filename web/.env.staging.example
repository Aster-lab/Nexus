# Copy to .env.staging (ignored by Git). Use dedicated non-production accounts.
E2E_BASE_URL=https://staging.example.invalid
E2E_BORROWER_EMAIL=borrower.e2e@example.invalid
E2E_BORROWER_PASSWORD=replace-with-secret
E2E_INVESTOR_EMAIL=investor.e2e@example.invalid
E2E_INVESTOR_PASSWORD=replace-with-secret
E2E_ADMIN_EMAIL=admin.e2e@example.invalid
E2E_ADMIN_PASSWORD=replace-with-secret
# Optional: Vercel Deployment Protection > Protection Bypass for Automation.
# Required only when the Preview deployment is protected by Vercel Authentication.
VERCEL_AUTOMATION_BYPASS_SECRET=replace-with-vercel-generated-secret
